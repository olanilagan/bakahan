---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { href, langStaticPaths, useT, type Lang } from '../../../i18n/utils';
import type { UIKey } from '../../../i18n/ui';

export const prerender = true;
export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

const articles = (await getCollection('articles', (a) => a.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const icons: Record<string, string> = {
  basics: '🌱',
  breeds: '🐂',
  fattening: '⚖️',
  feeding: '🌾',
  health: '🩺',
  business: '💰',
  market: '🏷️',
};
---

<Base lang={lang} title={t('learn.title')} description={t('learn.lead')}>
  <section class="page-head">
    <div class="container">
      <h1>{t('learn.title')}</h1>
      <p class="lead">{t('learn.lead')}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ol class="grid guides">
        {
          articles.map((a, i) => (
            <li>
              <a class="card guide" href={href(lang, `/learn/${a.id.split('/')[1]}`)}>
                <div class="guide__top">
                  <span class="guide__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="tag">
                    {icons[a.data.category]} {t(`cat.${a.data.category}` as UIKey)}
                  </span>
                </div>
                <h3>{a.data.title}</h3>
                <p class="muted">{a.data.description}</p>
                {a.data.readingMinutes && (
                  <p class="small muted">
                    {a.data.readingMinutes} {t('learn.minutes')}
                  </p>
                )}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .guides {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .guide {
    height: 100%;
  }
  .guide__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .guide__num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--straw-500);
    font-weight: 700;
  }
</style>
