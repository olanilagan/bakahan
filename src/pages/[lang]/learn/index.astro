---
// Rendered on request (not pre-built) so scheduled guides appear on their
// publish date without a redeploy. See src/lib/guides.ts.
import Base from '../../../layouts/Base.astro';
import { href, useT } from '../../../i18n/utils';
import type { UIKey } from '../../../i18n/ui';
import { GUIDE_COVERS, PHOTOS, photoSrc } from '../../../lib/photos';
import { isNew, publishedGuides, slugOf } from '../../../lib/guides';
import { notFound, pageLang } from '../../../lib/page';

export const prerender = false;

const lang = pageLang(Astro);
if (!lang) return notFound();
const t = useT(lang);
const articles = await publishedGuides(lang);
---

<Base lang={lang} title={t('learn.title')} description={t('learn.lead')}>
  <section class="page-head">
    <div class="container">
      <h1>{t('learn.title')}</h1>
      <p class="lead">{t('learn.lead')}</p>
    </div>
  </section>
  <section class="section" style="padding-top:20px">
    <div class="container">
      <ul class="rule-list guides">
        {
          articles.map((a) => {
            const slug = slugOf(a);
            const cover = GUIDE_COVERS[slug];
            return (
              <li class="guide-row">
                <div>
                  <span class="tag">{t(`cat.${a.data.category}` as UIKey)}</span>
                  {isNew(a) && <span class="tag tag--straw"> · {t('learn.new')}</span>}
                  <h3>
                    <a href={href(lang, `/learn/${slug}`)}>{a.data.title}</a>
                  </h3>
                  <p class="muted">{a.data.description}</p>
                  {a.data.readingMinutes && (
                    <p class="small muted" style="margin-top:6px">
                      {a.data.readingMinutes} {t('learn.minutes')}
                    </p>
                  )}
                </div>
                {cover && <img src={photoSrc(cover, 800)} alt={PHOTOS[cover].alt[lang]} width="220" height="147" loading="lazy" />}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .guides {
    max-width: 900px;
  }
  .guide-row {
    display: grid;
    grid-template-columns: 1fr 112px;
    gap: 16px;
    align-items: start;
  }
  .guide-row img {
    width: 112px;
    height: 75px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-top: 4px;
  }
  @media (min-width: 640px) {
    .guide-row {
      grid-template-columns: 1fr 220px;
      gap: 28px;
    }
    .guide-row img {
      width: 220px;
      height: 147px;
    }
  }
</style>
