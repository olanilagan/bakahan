---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { href, langStaticPaths, useT, type Lang } from '../../../i18n/utils';
import type { UIKey } from '../../../i18n/ui';

export const prerender = true;
export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

const articles = (await getCollection('articles', (a) => a.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base lang={lang} title={t('learn.title')} description={t('learn.lead')}>
  <section class="page-head">
    <div class="container">
      <h1>{t('learn.title')}</h1>
      <p class="lead">{t('learn.lead')}</p>
    </div>
  </section>
  <section class="section" style="padding-top:20px">
    <div class="container">
      <ul class="rule-list guides">
        {
          articles.map((a) => (
            <li>
              <span class="tag">{t(`cat.${a.data.category}` as UIKey)}</span>
              <h3>
                <a href={href(lang, `/learn/${a.id.split('/')[1]}`)}>{a.data.title}</a>
              </h3>
              <p class="muted">{a.data.description}</p>
              {a.data.readingMinutes && (
                <p class="small muted" style="margin-top:6px">
                  {a.data.readingMinutes} {t('learn.minutes')}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .guides {
    max-width: 820px;
  }
</style>
