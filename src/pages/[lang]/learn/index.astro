---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { href, langStaticPaths, useT, type Lang } from '../../../i18n/utils';
import type { UIKey } from '../../../i18n/ui';
import { GUIDE_COVERS, PHOTOS, photoSrc } from '../../../lib/photos';

export const prerender = true;
export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

const articles = (await getCollection('articles', (a) => a.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base lang={lang} title={t('learn.title')} description={t('learn.lead')}>
  <section class="page-head">
    <div class="container">
      <h1>{t('learn.title')}</h1>
      <p class="lead">{t('learn.lead')}</p>
    </div>
  </section>
  <section class="section" style="padding-top:20px">
    <div class="container">
      <ul class="rule-list guides">
        {
          articles.map((a) => (
            <li class="guide-row">
              <div>
              <span class="tag">{t(`cat.${a.data.category}` as UIKey)}</span>
              <h3>
                <a href={href(lang, `/learn/${a.id.split('/')[1]}`)}>{a.data.title}</a>
              </h3>
              <p class="muted">{a.data.description}</p>
              {a.data.readingMinutes && (
                <p class="small muted" style="margin-top:6px">
                  {a.data.readingMinutes} {t('learn.minutes')}
                </p>
              )}
              </div>
              {GUIDE_COVERS[a.id.split('/')[1]!] && (
                <img
                  src={photoSrc(GUIDE_COVERS[a.id.split('/')[1]!]!, 800)}
                  alt={PHOTOS[GUIDE_COVERS[a.id.split('/')[1]!]!].alt[lang]}
                  width="220"
                  height="147"
                  loading="lazy"
                />
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .guides {
    max-width: 900px;
  }
  .guide-row {
    display: grid;
    grid-template-columns: 1fr 112px;
    gap: 16px;
    align-items: start;
  }
  .guide-row img {
    width: 112px;
    height: 75px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-top: 4px;
  }
  @media (min-width: 640px) {
    .guide-row {
      grid-template-columns: 1fr 220px;
      gap: 28px;
    }
    .guide-row img {
      width: 220px;
      height: 147px;
    }
  }
</style>
