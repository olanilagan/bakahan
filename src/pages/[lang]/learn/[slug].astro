---
// A single guide. Rendered on request so a scheduled guide only becomes
// reachable on its publish date (before that this URL is a 404).
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import SponsorSlot from '../../../components/SponsorSlot.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { formatDate, href, useT } from '../../../i18n/utils';
import type { UIKey } from '../../../i18n/ui';
import { GUIDE_COVERS } from '../../../lib/photos';
import { dateKey, isPublished, publishedGuides, slugOf } from '../../../lib/guides';
import { notFound, pageLang } from '../../../lib/page';

export const prerender = false;

const lang = pageLang(Astro);
if (!lang) return notFound();
const t = useT(lang);
const slug = String(Astro.params.slug ?? '');
const entry = /^[a-z0-9-]+$/.test(slug) ? await getEntry('articles', `${lang}/${slug}`) : undefined;
if (!entry || !isPublished(entry)) return notFound();

const siblings = await publishedGuides(lang);
const next = siblings[siblings.findIndex((a) => a.id === entry.id) + 1];
const { Content } = await render(entry);
const cover = GUIDE_COVERS[slug];
const wasUpdated = dateKey(entry.data.updated) > dateKey(entry.data.publishDate);
---

<Base lang={lang} title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="page-head">
      <div class="container">
        <a class="small" href={href(lang, '/learn')}>← {t('learn.back')}</a>
        <p style="margin:12px 0 8px">
          <span class="tag">{t(`cat.${entry.data.category}` as UIKey)}</span>
        </p>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
        <p class="small muted">
          {t('learn.published')}{' '}{formatDate(lang, entry.data.publishDate)}
          {wasUpdated && <> · {t('learn.updated')} {formatDate(lang, entry.data.updated)}</>}
          {entry.data.readingMinutes && <> · {entry.data.readingMinutes} {t('learn.minutes')}</>}
        </p>
      </div>
    </header>

    <div class="container section">
      <div class="prose">
        {cover && <Photo name={cover} lang={lang} eager sizes="(min-width: 760px) 700px, 100vw" class="cover" />}
        <Content />

        <p class="alert alert--note small" style="margin-top:2em">{t('learn.disclaimer')}</p>

        <SponsorSlot lang={lang} placement="guides" />
        <AdSlot slot="article" />

        {
          entry.data.sources.length > 0 && (
            <section class="sources">
              <h2>{t('learn.sources')}</h2>
              <ol>
                {entry.data.sources.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener nofollow" target="_blank">
                      {s.title}
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          next && (
            <a class="card next" href={href(lang, `/learn/${slugOf(next)}`)}>
              <span class="tag">{t('learn.next')} →</span>
              <h3>{next.data.title}</h3>
            </a>
          )
        }
      </div>
    </div>
  </article>
</Base>

<style>
  .sources {
    font-size: 0.92rem;
  }
  .sources h2 {
    font-size: 1.2rem;
  }
  .sources a {
    word-break: break-word;
  }
  .next {
    margin-top: 2em;
  }
  .next h3 {
    margin: 0;
  }
  .prose :global(.cover) {
    margin-bottom: 2em;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
</style>
