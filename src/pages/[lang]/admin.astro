---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { formatDate, useT } from '../../i18n/utils';
import type { UIKey } from '../../i18n/ui';
import { pageLang, notFound } from '../../lib/page';
import { hashPassword } from '../../lib/auth';
import { safeUrl, str, todayPH } from '../../lib/form';
import { dateKey, scheduledGuides, slugOf } from '../../lib/guides';

export const prerender = false;

const lang = pageLang(Astro);
if (!lang) return notFound();
const t = useT(lang);
const user = Astro.locals.user;
// Non-admins get a 404 rather than "forbidden", so the page's existence isn't advertised.
if (!user?.isAdmin) return notFound();

// Temporary passwords avoid look-alike characters (0/O, 1/l/I) so they can be read out over the phone.
function tempPassword(): string {
  const alphabet = 'abcdefghjkmnpqrstuvwxyz23456789';
  const bytes = crypto.getRandomValues(new Uint8Array(10));
  return [...bytes].map((b) => alphabet[b % alphabet.length]).join('');
}

let resetNotice: { name: string; email: string; password: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  const action = form.get('action');
  if (Number.isInteger(id) && (action === 'approve' || action === 'reject')) {
    await env.DB.prepare('UPDATE businesses SET status = ? WHERE id = ?')
      .bind(action === 'approve' ? 'approved' : 'rejected', id)
      .run();
    return Astro.redirect(Astro.url.pathname, 303);
  }
  if (Number.isInteger(id) && (action === 'feature' || action === 'unfeature')) {
    // Featured for 30 days from today (Philippine time); "unfeature" ends it now.
    const until = new Date(Date.now() + 8 * 3_600_000 + 30 * 86_400_000).toISOString().slice(0, 10);
    await env.DB.prepare('UPDATE businesses SET featured_until = ? WHERE id = ?')
      .bind(action === 'feature' ? until : null, id)
      .run();
    return Astro.redirect(Astro.url.pathname + '#directory', 303);
  }
  if (action === 'sponsor-add') {
    const name = str(form, 'name', 80);
    const message = str(form, 'message_en', 160);
    const placement = ['all', 'home', 'guides', 'market'].includes(String(form.get('placement'))) ? String(form.get('placement')) : 'all';
    const starts = str(form, 'starts_on', 10) ?? todayPH();
    const ends = str(form, 'ends_on', 10);
    const isDate = (d: string | null) => !!d && /^\d{4}-\d{2}-\d{2}$/.test(d);
    if (name && message && isDate(starts) && isDate(ends)) {
      await env.DB.prepare(
        `INSERT INTO sponsors (name, url, message_en, message_fil, placement, starts_on, ends_on, notes) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
      )
        .bind(name, safeUrl(str(form, 'url', 200)), message, str(form, 'message_fil', 160), placement, starts, ends, str(form, 'notes', 300))
        .run();
    }
    return Astro.redirect(Astro.url.pathname + '#sponsors', 303);
  }
  if (Number.isInteger(id) && action === 'sponsor-toggle') {
    await env.DB.prepare('UPDATE sponsors SET active = 1 - active WHERE id = ?').bind(id).run();
    return Astro.redirect(Astro.url.pathname + '#sponsors', 303);
  }
  if (Number.isInteger(id) && action === 'reset-password') {
    // No email on the free plan, so the admin resets the password and tells the member directly.
    const member = await env.DB.prepare('SELECT name, email FROM users WHERE id = ?').bind(id).first<{ name: string; email: string }>();
    if (member) {
      const password = tempPassword();
      await env.DB.batch([
        env.DB.prepare('UPDATE users SET password_hash = ? WHERE id = ?').bind(await hashPassword(password), id),
        env.DB.prepare('DELETE FROM sessions WHERE user_id = ?').bind(id), // log them out everywhere
      ]);
      resetNotice = { ...member, password };
      Astro.response.headers.set('Cache-Control', 'no-store');
    }
  }
}

// D1 batch: several queries in one round trip to the database.
const now = new Date().toISOString();
const [pending, users, listings, prices, waitlist, members, messages, approvedBiz, sponsorList] = await env.DB.batch([
  env.DB.prepare(
    `SELECT b.*, u.name AS submitted_by, u.email AS submitter_email FROM businesses b
       LEFT JOIN users u ON u.id = b.user_id WHERE b.status = 'pending' ORDER BY b.created_at`,
  ),
  env.DB.prepare('SELECT COUNT(*) AS n FROM users'),
  env.DB.prepare("SELECT COUNT(*) AS n FROM listings WHERE status = 'active' AND expires_at > ?").bind(now),
  env.DB.prepare('SELECT COUNT(*) AS n FROM price_reports'),
  env.DB.prepare('SELECT COUNT(*) AS n FROM waitlist'),
  env.DB.prepare('SELECT id, name, email, region, role, phone, created_at FROM users ORDER BY created_at DESC LIMIT 200'),
  env.DB.prepare('SELECT id, topic, name, email, phone, message, emailed, created_at FROM contact_messages ORDER BY created_at DESC LIMIT 50'),
  env.DB.prepare("SELECT id, name, category, region, featured_until FROM businesses WHERE status = 'approved' ORDER BY name COLLATE NOCASE"),
  env.DB.prepare('SELECT id, name, url, message_en, placement, starts_on, ends_on, active, notes FROM sponsors ORDER BY ends_on DESC'),
]);
type ApprovedBiz = { id: number; name: string; category: string; region: string; featured_until: string | null };
const bizRows = (approvedBiz?.results ?? []) as ApprovedBiz[];
type SponsorRow = { id: number; name: string; url: string | null; message_en: string; placement: string; starts_on: string; ends_on: string; active: number; notes: string | null };
const sponsorRows = (sponsorList?.results ?? []) as SponsorRow[];
const today = todayPH();
const upcoming = await scheduledGuides();
type Message = { id: number; topic: string; name: string; email: string; phone: string | null; message: string; emailed: number; created_at: string };
const messageRows = (messages?.results ?? []) as Message[];
type Member = { id: number; name: string; email: string; region: string | null; role: string; phone: string | null; created_at: string };
const memberRows = (members?.results ?? []) as Member[];

type Pending = {
  id: number;
  name: string;
  category: string;
  description: string | null;
  region: string;
  location: string | null;
  phone: string | null;
  website: string | null;
  created_at: string;
  submitted_by: string | null;
  submitter_email: string | null;
};
const pendingRows = (pending?.results ?? []) as Pending[];
const count = (r: D1Result | undefined) => ((r?.results?.[0] as { n: number } | undefined)?.n ?? 0);
const stats = [
  [t('admin.users'), count(users)],
  [t('admin.listings'), count(listings)],
  [t('admin.prices'), count(prices)],
  [t('admin.waitlist'), count(waitlist)],
] as const;
---

<Base lang={lang} title={t('admin.title')} noindex>
  <section class="page-head">
    <div class="container"><h1>{t('admin.title')}</h1></div>
  </section>
  <section class="section">
    <div class="container" style="display:grid; gap:36px">
      {
        resetNotice && (
          <p class="alert alert--ok">
            New temporary password for {resetNotice.name} ({resetNotice.email}): <strong style="font-family:monospace; font-size:1.2rem">{resetNotice.password}</strong>
            <br />
            <span class="small">Give this to the member directly. It is shown only once. They can log in with it now.</span>
          </p>
        )
      }
      <div>
        <h2>{t('admin.stats')}</h2>
        <div class="grid">
          {
            stats.map(([label, n]) => (
              <div class="card">
                <div class="muted">{label}</div>
                <div style="font-family:var(--font-display); font-size:2.2rem; font-weight:700">{n}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h2>{t('admin.pending')}</h2>
        {pendingRows.length === 0 && <p class="muted">{t('admin.none')}</p>}
        <div class="grid">
          {
            pendingRows.map((b) => (
              <div class="card">
                <span class="tag">{t(`dircat.${b.category}` as UIKey)}</span>
                <h3 style="margin-top:8px">{b.name}</h3>
                {b.description && <p class="muted">{b.description}</p>}
                <p class="small">
                  {b.location ? `${b.location}, ` : ''}
                  {b.region}
                  <br />
                  {b.phone && <>{b.phone}<br /></>}
                  {b.website && <>{b.website}<br /></>}
                  {formatDate(lang, b.created_at)} · {b.submitted_by} ({b.submitter_email})
                </p>
                <form method="post" class="btn-row">
                  <input type="hidden" name="id" value={b.id} />
                  <button class="btn btn--primary btn--small" name="action" value="approve">
                    {t('admin.approve')}
                  </button>
                  <button class="btn btn--danger btn--small" name="action" value="reject">
                    {t('admin.reject')}
                  </button>
                </form>
              </div>
            ))
          }
        </div>
      </div>

      <div id="schedule">
        <h2>Guide publishing calendar</h2>
        <p class="muted small">Scheduled guides go live automatically on their date (Philippine time). Nothing to do here; this is for reference.</p>
        {upcoming.length === 0 && <p class="muted">No guides scheduled. Time to write the next batch.</p>}
        {
          upcoming.length > 0 && (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>Date</th><th>Guide</th><th>Slug</th></tr>
                </thead>
                <tbody>
                  {upcoming.map((g) => (
                    <tr>
                      <td style="white-space:nowrap">{dateKey(g.data.publishDate)}</td>
                      <td>{g.data.title}</td>
                      <td class="muted small">{slugOf(g)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </div>

      <div id="sponsors">
        <h2>Sponsors</h2>
        <p class="muted small">"Sponsored by" lines on the home page, guides and marketplace. Shown only between the start and end dates while active. Several sponsors in the same spot take turns.</p>
        {
          sponsorRows.length > 0 && (
            <div class="table-wrap" style="margin-bottom:20px">
              <table>
                <thead>
                  <tr><th>Sponsor</th><th>Where</th><th>Dates</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                  {sponsorRows.map((sp) => {
                    const live = sp.active === 1 && sp.starts_on <= today && sp.ends_on >= today;
                    return (
                      <tr>
                        <td>
                          <strong>{sp.name}</strong>
                          <br />
                          <span class="small muted">{sp.message_en}</span>
                          {sp.notes && <><br /><span class="small muted">Note: {sp.notes}</span></>}
                        </td>
                        <td>{sp.placement}</td>
                        <td style="white-space:nowrap">{sp.starts_on} to {sp.ends_on}</td>
                        <td>{live ? 'Live' : sp.active ? (sp.ends_on < today ? 'Ended' : 'Scheduled') : 'Paused'}</td>
                        <td>
                          <form method="post">
                            <input type="hidden" name="id" value={sp.id} />
                            <button class="btn btn--ghost btn--small" name="action" value="sponsor-toggle">{sp.active ? 'Pause' : 'Resume'}</button>
                          </form>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )
        }
        <details class="card">
          <summary><strong>+ Add a sponsor</strong></summary>
          <form method="post" class="form form--wide" style="margin-top:16px">
            <input type="hidden" name="action" value="sponsor-add" />
            <div class="form-row">
              <label>Business name<input name="name" required maxlength="80" /></label>
              <label>Link (website or Facebook)<input name="url" maxlength="200" /></label>
            </div>
            <label>Message in English (one short sentence)<input name="message_en" required maxlength="160" placeholder="Quality feeds for fattening, delivered in Batangas." /></label>
            <label>Message in Filipino (optional)<input name="message_fil" maxlength="160" /></label>
            <div class="form-row">
              <label>Where
                <select name="placement">
                  <option value="all">Everywhere</option>
                  <option value="home">Home page</option>
                  <option value="guides">Guides</option>
                  <option value="market">Marketplace</option>
                </select>
              </label>
              <label>Starts<input name="starts_on" type="date" required value={today} /></label>
              <label>Ends<input name="ends_on" type="date" required /></label>
            </div>
            <label>Private note (price, contact person; not shown on the site)<input name="notes" maxlength="300" /></label>
            <div><button class="btn btn--primary" type="submit">Add sponsor</button></div>
          </form>
        </details>
      </div>

      <div id="directory">
        <h2>Directory: featured listings</h2>
        {bizRows.length === 0 && <p class="muted">No approved businesses yet.</p>}
        {
          bizRows.length > 0 && (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>Business</th><th>Category</th><th>Featured</th><th></th></tr>
                </thead>
                <tbody>
                  {bizRows.map((b) => {
                    const featured = !!b.featured_until && b.featured_until >= today;
                    return (
                      <tr>
                        <td>{b.name}<br /><span class="small muted">{b.region}</span></td>
                        <td>{t(`dircat.${b.category}` as UIKey)}</td>
                        <td>{featured ? `Until ${b.featured_until}` : '-'}</td>
                        <td>
                          <form method="post">
                            <input type="hidden" name="id" value={b.id} />
                            {featured ? (
                              <button class="btn btn--ghost btn--small" name="action" value="unfeature">Stop featuring</button>
                            ) : (
                              <button class="btn btn--primary btn--small" name="action" value="feature">Feature 30 days</button>
                            )}
                          </form>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )
        }
      </div>

      <div>
        <h2>{t('admin.messages')}</h2>
        {messageRows.length === 0 && <p class="muted">{t('admin.none')}</p>}
        <ul class="rule-list">
          {
            messageRows.map((m) => (
              <li>
                <span class="tag">{t(`contact.topic.${m.topic}` as UIKey)}</span>
                <p>
                  <strong>{m.name}</strong> · <a href={`mailto:${m.email}`}>{m.email}</a>
                  {m.phone && <> · {m.phone}</>} · <span class="muted small">{formatDate(lang, m.created_at)}{m.emailed ? '' : ' · not emailed'}</span>
                </p>
                <p style="white-space:pre-line; margin-top:6px">{m.message}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>{t('admin.users')}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Name</th><th>Email</th><th>Region</th><th>Role</th><th>Joined</th><th></th></tr>
            </thead>
            <tbody>
              {
                memberRows.map((m) => (
                  <tr>
                    <td>{m.name}</td>
                    <td>{m.email}</td>
                    <td>{m.region}</td>
                    <td>{t(`role.${m.role}` as UIKey)}</td>
                    <td style="white-space:nowrap">{formatDate(lang, m.created_at)}</td>
                    <td>
                      <form method="post" onsubmit="return confirm('Reset this member’s password? They will be logged out.')">
                        <input type="hidden" name="id" value={m.id} />
                        <button class="btn btn--ghost btn--small" name="action" value="reset-password">Reset password</button>
                      </form>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Base>
