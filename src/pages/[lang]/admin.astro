---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { formatDate, useT } from '../../i18n/utils';
import type { UIKey } from '../../i18n/ui';
import { pageLang, notFound } from '../../lib/page';
import { hashPassword } from '../../lib/auth';

export const prerender = false;

const lang = pageLang(Astro);
if (!lang) return notFound();
const t = useT(lang);
const user = Astro.locals.user;
// Non-admins get a 404 rather than "forbidden", so the page's existence isn't advertised.
if (!user?.isAdmin) return notFound();

// Temporary passwords avoid look-alike characters (0/O, 1/l/I) so they can be read out over the phone.
function tempPassword(): string {
  const alphabet = 'abcdefghjkmnpqrstuvwxyz23456789';
  const bytes = crypto.getRandomValues(new Uint8Array(10));
  return [...bytes].map((b) => alphabet[b % alphabet.length]).join('');
}

let resetNotice: { name: string; email: string; password: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  const action = form.get('action');
  if (Number.isInteger(id) && (action === 'approve' || action === 'reject')) {
    await env.DB.prepare('UPDATE businesses SET status = ? WHERE id = ?')
      .bind(action === 'approve' ? 'approved' : 'rejected', id)
      .run();
    return Astro.redirect(Astro.url.pathname, 303);
  }
  if (Number.isInteger(id) && action === 'reset-password') {
    // No email on the free plan, so the admin resets the password and tells the member directly.
    const member = await env.DB.prepare('SELECT name, email FROM users WHERE id = ?').bind(id).first<{ name: string; email: string }>();
    if (member) {
      const password = tempPassword();
      await env.DB.batch([
        env.DB.prepare('UPDATE users SET password_hash = ? WHERE id = ?').bind(await hashPassword(password), id),
        env.DB.prepare('DELETE FROM sessions WHERE user_id = ?').bind(id), // log them out everywhere
      ]);
      resetNotice = { ...member, password };
      Astro.response.headers.set('Cache-Control', 'no-store');
    }
  }
}

// D1 batch: several queries in one round trip to the database.
const now = new Date().toISOString();
const [pending, users, listings, prices, waitlist, members, messages] = await env.DB.batch([
  env.DB.prepare(
    `SELECT b.*, u.name AS submitted_by, u.email AS submitter_email FROM businesses b
       LEFT JOIN users u ON u.id = b.user_id WHERE b.status = 'pending' ORDER BY b.created_at`,
  ),
  env.DB.prepare('SELECT COUNT(*) AS n FROM users'),
  env.DB.prepare("SELECT COUNT(*) AS n FROM listings WHERE status = 'active' AND expires_at > ?").bind(now),
  env.DB.prepare('SELECT COUNT(*) AS n FROM price_reports'),
  env.DB.prepare('SELECT COUNT(*) AS n FROM waitlist'),
  env.DB.prepare('SELECT id, name, email, region, role, phone, created_at FROM users ORDER BY created_at DESC LIMIT 200'),
  env.DB.prepare('SELECT id, topic, name, email, phone, message, emailed, created_at FROM contact_messages ORDER BY created_at DESC LIMIT 50'),
]);
type Message = { id: number; topic: string; name: string; email: string; phone: string | null; message: string; emailed: number; created_at: string };
const messageRows = (messages?.results ?? []) as Message[];
type Member = { id: number; name: string; email: string; region: string | null; role: string; phone: string | null; created_at: string };
const memberRows = (members?.results ?? []) as Member[];

type Pending = {
  id: number;
  name: string;
  category: string;
  description: string | null;
  region: string;
  location: string | null;
  phone: string | null;
  website: string | null;
  created_at: string;
  submitted_by: string | null;
  submitter_email: string | null;
};
const pendingRows = (pending?.results ?? []) as Pending[];
const count = (r: D1Result | undefined) => ((r?.results?.[0] as { n: number } | undefined)?.n ?? 0);
const stats = [
  [t('admin.users'), count(users)],
  [t('admin.listings'), count(listings)],
  [t('admin.prices'), count(prices)],
  [t('admin.waitlist'), count(waitlist)],
] as const;
---

<Base lang={lang} title={t('admin.title')} noindex>
  <section class="page-head">
    <div class="container"><h1>{t('admin.title')}</h1></div>
  </section>
  <section class="section">
    <div class="container" style="display:grid; gap:36px">
      {
        resetNotice && (
          <p class="alert alert--ok">
            New temporary password for {resetNotice.name} ({resetNotice.email}): <strong style="font-family:monospace; font-size:1.2rem">{resetNotice.password}</strong>
            <br />
            <span class="small">Give this to the member directly. It is shown only once. They can log in with it now.</span>
          </p>
        )
      }
      <div>
        <h2>{t('admin.stats')}</h2>
        <div class="grid">
          {
            stats.map(([label, n]) => (
              <div class="card">
                <div class="muted">{label}</div>
                <div style="font-family:var(--font-display); font-size:2.2rem; font-weight:700">{n}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h2>{t('admin.pending')}</h2>
        {pendingRows.length === 0 && <p class="muted">{t('admin.none')}</p>}
        <div class="grid">
          {
            pendingRows.map((b) => (
              <div class="card">
                <span class="tag">{t(`dircat.${b.category}` as UIKey)}</span>
                <h3 style="margin-top:8px">{b.name}</h3>
                {b.description && <p class="muted">{b.description}</p>}
                <p class="small">
                  {b.location ? `${b.location}, ` : ''}
                  {b.region}
                  <br />
                  {b.phone && <>{b.phone}<br /></>}
                  {b.website && <>{b.website}<br /></>}
                  {formatDate(lang, b.created_at)} · {b.submitted_by} ({b.submitter_email})
                </p>
                <form method="post" class="btn-row">
                  <input type="hidden" name="id" value={b.id} />
                  <button class="btn btn--primary btn--small" name="action" value="approve">
                    {t('admin.approve')}
                  </button>
                  <button class="btn btn--danger btn--small" name="action" value="reject">
                    {t('admin.reject')}
                  </button>
                </form>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h2>{t('admin.messages')}</h2>
        {messageRows.length === 0 && <p class="muted">{t('admin.none')}</p>}
        <ul class="rule-list">
          {
            messageRows.map((m) => (
              <li>
                <span class="tag">{t(`contact.topic.${m.topic}` as UIKey)}</span>
                <p>
                  <strong>{m.name}</strong> · <a href={`mailto:${m.email}`}>{m.email}</a>
                  {m.phone && <> · {m.phone}</>} · <span class="muted small">{formatDate(lang, m.created_at)}{m.emailed ? '' : ' · not emailed'}</span>
                </p>
                <p style="white-space:pre-line; margin-top:6px">{m.message}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>{t('admin.users')}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Name</th><th>Email</th><th>Region</th><th>Role</th><th>Joined</th><th></th></tr>
            </thead>
            <tbody>
              {
                memberRows.map((m) => (
                  <tr>
                    <td>{m.name}</td>
                    <td>{m.email}</td>
                    <td>{m.region}</td>
                    <td>{t(`role.${m.role}` as UIKey)}</td>
                    <td style="white-space:nowrap">{formatDate(lang, m.created_at)}</td>
                    <td>
                      <form method="post" onsubmit="return confirm('Reset this member’s password? They will be logged out.')">
                        <input type="hidden" name="id" value={m.id} />
                        <button class="btn btn--ghost btn--small" name="action" value="reset-password">Reset password</button>
                      </form>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Base>
