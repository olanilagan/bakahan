---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { GUIDE_COVERS, photoSrc } from '../../lib/photos';
import LatestListings from '../../components/LatestListings.astro';
import { href, langStaticPaths, useT, type Lang } from '../../i18n/utils';
import type { UIKey } from '../../i18n/ui';

export const prerender = true;
export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

const guides = (await getCollection('articles', (a) => a.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const more = [
  { title: t('home.prices.title'), body: t('home.prices.body'), link: '/prices', label: t('nav.prices') },
  { title: t('home.directory.title'), body: t('home.directory.body'), link: '/directory', label: t('nav.directory') },
  { title: t('home.app.title'), body: t('home.app.body'), link: '/app', label: t('home.app.cta') },
];
---

<Base lang={lang}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1>{t('home.hero.title')}</h1>
        <p class="lead">{t('home.hero.lead')}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={href(lang, '/learn')}>{t('home.hero.cta1')}</a>
          <a class="btn btn--ghost" href={href(lang, '/market')}>{t('home.hero.cta2')}</a>
        </div>
      </div>
      <div class="hero__art">
        <Photo name="hero-brahman-lipa" lang={lang} eager sizes="(min-width: 900px) 540px, 100vw" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container columns">
      <div>
        <div class="col-head">
          <h2>{t('learn.title')}</h2>
          <a class="more" href={href(lang, '/learn')}>{t('learn.back')} →</a>
        </div>
        <ul class="rule-list">
          {
            guides.map((g) => {
              const slug = g.id.split('/')[1]!;
              const cover = GUIDE_COVERS[slug];
              return (
                <li class="guide-row">
                  <div>
                    <span class="tag">{t(`cat.${g.data.category}` as UIKey)}</span>
                    <h3>
                      <a href={href(lang, `/learn/${slug}`)}>{g.data.title}</a>
                    </h3>
                    <p class="muted">{g.data.description}</p>
                  </div>
                  {cover && <img src={photoSrc(cover, 800)} alt="" width="160" height="107" loading="lazy" />}
                </li>
              );
            })
          }
        </ul>
      </div>

      <div>
        <div class="col-head">
          <h2>{t('home.latest.title')}</h2>
          <a class="more" href={href(lang, '/market')}>{t('home.latest.all')} →</a>
        </div>
        <LatestListings server:defer lang={lang}>
          <p slot="fallback" class="muted">…</p>
        </LatestListings>
        <p style="margin-top:16px">
          <a class="btn btn--primary btn--small" href={href(lang, '/market/new')}>{t('market.post')}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container trio">
      {
        more.map((m) => (
          <div>
            <h2>{m.title}</h2>
            <p>{m.body}</p>
            <a class="more" href={href(lang, m.link)}>
              {m.label} →
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container farm">
      <Photo name="farm-borongan" lang={lang} sizes="(min-width: 860px) 540px, 100vw" />
      <div>
        <h2>{t('home.farm.title')}</h2>
        <p class="lead">{t('home.farm.body')}</p>
        <a class="btn btn--ghost" href={href(lang, '/farm')}>{t('home.farm.cta')}</a>
      </div>
    </div>
  </section>

  <section class="join">
    <div class="container join__inner">
      <div>
        <h2>{t('home.join.title')}</h2>
        <p>{t('home.join.body')}</p>
      </div>
      <a class="btn btn--straw" href={href(lang, '/signup')}>{t('nav.signup')}</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--green-50);
    border-bottom: 1px solid var(--border);
    padding: 32px 0 40px;
  }
  .hero__grid {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.4rem);
    margin-bottom: 0.35em;
  }
  .hero .lead {
    margin-bottom: 1.4em;
  }
  @media (min-width: 900px) {
    .hero {
      padding: 56px 0;
    }
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
    }
  }
  .columns {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .columns {
      grid-template-columns: 1.4fr 1fr;
      gap: 56px;
    }
  }
  .col-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }
  .col-head h2 {
    margin: 0;
  }
  .trio {
    display: grid;
    gap: 28px;
  }
  .trio h2 {
    font-size: 1.5rem;
  }
  @media (min-width: 820px) {
    .trio {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .trio > div {
      padding: 0 28px;
      border-left: 1px solid var(--green-200);
    }
    .trio > div:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
  .farm {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .farm {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
  }
  .guide-row {
    display: grid;
    grid-template-columns: 1fr 112px;
    gap: 16px;
    align-items: start;
  }
  .guide-row img {
    width: 112px;
    height: 75px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-top: 4px;
  }
  @media (min-width: 560px) {
    .guide-row {
      grid-template-columns: 1fr 160px;
      gap: 24px;
    }
    .guide-row img {
      width: 160px;
      height: 107px;
    }
  }
  .join {
    /* Photo behind a dark green overlay keeps the white text readable. */
    background:
      linear-gradient(rgba(20, 56, 34, 0.86), rgba(20, 56, 34, 0.86)),
      url('/images/photos/cow-catanduanes-1600.webp') center 60% / cover;
    color: #dcebdf;
    padding: 56px 0;
  }
  .join__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
  }
  .join h2 {
    color: #fff;
    margin-bottom: 0.2em;
  }
  .join p {
    margin: 0;
  }
</style>
