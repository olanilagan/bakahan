---
// A responsive photo with a short credit line. The browser picks the 800px or
// 1600px file depending on screen size (srcset), so phones download less.
import { PHOTOS, photoSrc, type PhotoKey } from '../lib/photos';
import type { Lang } from '../i18n/utils';

interface Props {
  name: PhotoKey;
  lang: Lang;
  sizes?: string;
  eager?: boolean;
  credit?: boolean;
  class?: string;
}
const { name, lang, sizes = '(min-width: 1120px) 1120px, 100vw', eager = false, credit = true, class: cls } = Astro.props;
const p = PHOTOS[name];
---

<figure class:list={['photo', cls]}>
  <img
    src={photoSrc(name, 800)}
    srcset={`${photoSrc(name, 800)} 800w, ${photoSrc(name, 1600)} 1600w`}
    sizes={sizes}
    width="1600"
    height="1067"
    alt={p.alt[lang]}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
  {
    credit && (
      <figcaption>
        {p.place}. Photo: {p.author}, <a href={p.source} rel="noopener" target="_blank">{p.license}</a>
      </figcaption>
    )
  }
</figure>

<style>
  .photo {
    margin: 0;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--green-100);
  }
  figcaption {
    margin-top: 6px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  figcaption a {
    color: inherit;
  }
</style>
