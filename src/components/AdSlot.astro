---
// A Google AdSense ad unit. Renders nothing at all until ADSENSE_CLIENT and the
// slot ID are set in src/lib/site.ts, so there are no empty boxes before approval.
import { ADSENSE_CLIENT, ADSENSE_SLOTS } from '../lib/site';

interface Props {
  slot: keyof typeof ADSENSE_SLOTS;
}
const slotId = ADSENSE_SLOTS[Astro.props.slot];
const enabled = ADSENSE_CLIENT !== '' && slotId !== '';
---

{
  enabled && (
    <aside class="ad" aria-label="Advertisement">
      <span class="ad__label">Advertisement</span>
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}

<style>
  .ad {
    margin: 32px 0;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .ad__label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
</style>
